# Ambiente local — copie para `.env` e preencha a senha da caixa.

# E-mail (OTP 2FA). Com EMAIL_HOST_USER preenchido, usa SMTP mesmo em DEBUG.
# Servidor próprio na VPS: mail.o5o.tech (MX de o5o.tech). Porta 465 + SSL.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.o5o.tech
EMAIL_PORT=465
EMAIL_HOST_USER=bibliotecaquintaldasartes@o5o.tech
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
DEFAULT_FROM_EMAIL=bibliotecaquintaldasartes@o5o.tech
FRONTEND_URL=http://localhost:11666
